# Copy to .env and fill in. Never commit .env.
LANGSMITH_API_KEY=
# Required by `mda connections` (README step 0).
LANGSMITH_WORKSPACE_ID=
ANTHROPIC_API_KEY=

# Your fork of the workshop game, as owner/name, e.g. octocat/simple-game.
# (README step 1)
PATCH_REPO=

# A fine-grained GitHub token scoped to ONLY your fork, with
# Contents + Pull requests (read and write). New tokens start read-only:
# set BOTH to "Read and write" or opening a PR fails with a 403.
# You'll create it in README step 3.2.
# - Under `mda dev`, the `patch-github` connection reads it from here.
# - For the deployment, you store it in LangSmith once (README step 3.2):
#     uv run mda connections create patch-github --secret-from-env MDA_DEV_PATCH_GITHUB
MDA_DEV_PATCH_GITHUB=

# Slack needs nothing here: `mda deploy` sets it up (README step 4).
